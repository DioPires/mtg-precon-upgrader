  "guideContent": {
    "strategyOverview": "Suit up Captain America and win two ways with the same gear. Catch attaches an Equipment free at the start of each of your combats, and Throw ({3}, reduced to {1} by Zirda) unattaches one to deal its mana value in damage split among up to three targets — the Equipment stays on the battlefield, so Catch re-attaches it next turn for a repeatable damage engine. The primary kill is 21 commander damage through Excalibur, Colossus Hammer, and Mjölnir's damage doubling; the backup plan converts high-mana-value gear into amplified Throw burn (Mjölnir doubles it, Fiery Emancipation triples it). Eight attach-cheat effects beyond Catch keep equip costs honest, Sunforger packages the deck's red-white instants, and Sword of Feast and Famine plus Aggravated Assault closes with infinite combats when the table demands it.",
    "deckCategories": [
      {
        "name": "Vibranium Payloads",
        "description": "High-mana-value Throw fuel: each of these deals its full mana value when thrown and comes back via Catch. Excalibur throws for 12 and usually casts for far less thanks to its historic cost reduction; Kaldra Compleat and Batterskull bring living-weapon bodies.",
        "cards": [
          "Excalibur, Sword of Eden",
          "Kaldra Compleat",
          "Argentum Armor",
          "Batterskull",
          "Genji Glove",
          "Hexplate Wallbreaker"
        ]
      },
      {
        "name": "Standard-Issue Kit",
        "description": "Cheap combat gear for the voltron line: Colossus Hammer plus a free attach is the classic one-shot, Mjölnir doubles all of Cap's damage (equip {1} — he is worthy), and Captain America's own Shield gives him +0/+8 and indestructibility to hide behind.",
        "cards": [
          "Colossus Hammer",
          "Mjölnir, Hammer of Thor",
          "Captain America's Shield",
          "Basilisk Collar",
          "Sword of Feast and Famine",
          "Sword of Fire and Ice",
          "Sword of Forge and Frontier",
          "Sunforger",
          "Buster Sword",
          "Masterwork of Ingenuity",
          "Mithril Coat",
          "Mask of Memory",
          "Lightning Greaves",
          "Sword of the Animist"
        ]
      },
      {
        "name": "Rapid Deployment",
        "description": "Attach-cheat density beyond Catch: flash attaches, free equips, mass re-attach at combat, and cost reduction. Zirda cuts Throw from {3} to {1} and shaves generic equip costs (it cannot discount Sunforger's all-colored unattach).",
        "cards": [
          "Sigarda's Aid",
          "Puresteel Paladin",
          "Hammer of Nazahn",
          "Ardenn, Intrepid Archaeologist",
          "Forge Anew",
          "Super-Soldier Serum",
          "Zirda, the Dawnwaker",
          "Codsworth, Handy Helper"
        ]
      },
      {
        "name": "Quartermaster Corps",
        "description": "Equipment tutors keep the draw consistent: Stoneforge cheats the fetched piece into play, Fighter Class tutors on entry then discounts every equip by {2}, and Armored Skyhunter digs six deep and attaches for free on attack.",
        "cards": [
          "Stoneforge Mystic",
          "Steelshaper's Gift",
          "Open the Armory",
          "Armored Skyhunter",
          "Fighter Class"
        ]
      },
      {
        "name": "S.H.I.E.L.D. Intel",
        "description": "Equipment-native card advantage. Sram and Puresteel cantrip every Equipment cast; Loki draws a card the first time each turn an ability you control targets — Catch, Throw, and every equip activation all qualify.",
        "cards": [
          "Sram, Senior Edificer",
          "Akiri, Fearless Voyager",
          "The Mighty Thor, Jane Foster",
          "Loki, God of Mischief",
          "Jhoira, Weatherlight Captain"
        ]
      },
      {
        "name": "Bodyguard Detail",
        "description": "Keeping one creature alive is the whole game plan: free counterspells and redirects while Cap is out, Bastion Protector's indestructibility, and Clever Concealment phasing the whole suit out of a board wipe with everything still attached.",
        "cards": [
          "Boros Charm",
          "Deflecting Swat",
          "Fierce Guardianship",
          "Bastion Protector",
          "Clever Concealment"
        ]
      },
      {
        "name": "Counteroffensive",
        "description": "Interaction that leans on the deck's shape: Dispatch's metalcraft is trivially on, Stubborn Denial is a one-mana Negate while 4-power Cap is deployed, and Single Combat is an asymmetric wrath that leaves the suited commander standing alone.",
        "cards": [
          "Swords to Plowshares",
          "Dispatch",
          "Abrade",
          "Rip Apart",
          "Generous Gift",
          "Stubborn Denial",
          "Dovin's Veto",
          "Single Combat",
          "Chandra's Ignition",
          "Mystical Tutor"
        ]
      },
      {
        "name": "Supply Lines",
        "description": "Artifact-lean acceleration. Dalakos taps for {C}{C} that pays equip costs (they are Equipment abilities) — though not Throw, which is Cap's own ability — and gives the equipped commander flying and haste.",
        "cards": [
          "Sol Ring",
          "Arcane Signet",
          "Talisman of Conviction",
          "Talisman of Progress",
          "Talisman of Creativity",
          "Mind Stone",
          "Fellwar Stone",
          "Dalakos, Crafter of Wonders"
        ]
      }
    ]
  },
