  "synergies": [
    {
      "title": "The hammer drop",
      "cards": [
        "Sigarda's Aid",
        "Colossus Hammer"
      ],
      "description": "Sigarda's Aid gives Equipment flash and attaches them free on entry — Colossus Hammer's equip {8} never gets paid. A 14/14 Captain America is a two-hit commander kill.",
      "sources": [
        {
          "type": "edhrec",
          "name": "EDHREC — Captain America, First Avenger",
          "detail": "Sigarda's Aid 87.6% inclusion, +0.82 synergy; Colossus Hammer 70.0%"
        }
      ]
    },
    {
      "title": "Worthy of the hammer",
      "cards": [
        "Mjölnir, Hammer of Thor",
        "Excalibur, Sword of Eden"
      ],
      "description": "Cap is legendary, non-Villain, and red-white — worthy, so Mjölnir equips for {1} and doubles all damage he deals. Excalibur in combat is 28 commander damage in one connect (4+10 power, doubled); thrown, it is 24 damage split up to three ways.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "DEC-422 kill-line analysis"
        }
      ]
    },
    {
      "title": "Infinite combat steps",
      "cards": [
        "Sword of Feast and Famine",
        "Aggravated Assault"
      ],
      "description": "Combat damage from the equipped commander untaps all lands; with five lands producing {3}{R}{R}, Aggravated Assault grants another combat every time — arbitrarily many attacks. Flagged as this deck's single compact combo line.",
      "sources": [
        {
          "type": "commanderspellbook",
          "name": "Commander Spellbook",
          "url": "https://commanderspellbook.com/combo/900-3750/",
          "detail": "Classic two-card combat loop; verified against the drafted 99"
        }
      ]
    },
    {
      "title": "Deathtouch fastball",
      "cards": [
        "Basilisk Collar",
        "Fiery Emancipation"
      ],
      "description": "With Basilisk Collar attached, every Throw split is deathtouch-and-lifelink removal — a three-way split kills three creatures regardless of size. Fiery Emancipation triples the same Throw at faces when the board is clear.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "DEC-422 Throw-engine analysis"
        }
      ]
    },
    {
      "title": "Every trigger is a draw",
      "cards": [
        "Loki, God of Mischief",
        "Sunforger"
      ],
      "description": "Loki draws the first time each turn an ability you control targets anything — Catch targets an Equipment, Throw targets up to three things, Sunforger's unattach-and-cast and every equip activation target too. One reliable extra card per turn cycle, often more across opponents' turns.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "DEC-422 owned-pool sweep find"
        }
      ]
    },
    {
      "title": "Field repair loop",
      "cards": [
        "Akiri, Fearless Voyager",
        "Hammer of Nazahn"
      ],
      "description": "Akiri unattaches an Equipment for {W} to make Cap indestructible in a pinch, and Catch re-attaches it free next combat; Hammer of Nazahn makes the same protection permanent while auto-attaching every Equipment that enters.",
      "sources": [
        {
          "type": "edhrec",
          "name": "EDHREC — Captain America, First Avenger",
          "detail": "Akiri 56.7%, Hammer of Nazahn 61.3% inclusion"
        }
      ]
    },
    {
      "title": "Sunforger package",
      "cards": [
        "Sunforger",
        "Boros Charm",
        "Deflecting Swat",
        "Swords to Plowshares"
      ],
      "description": "Unattach Sunforger to fetch and free-cast any of six red/white instants (Swords, Dispatch, Abrade, Generous Gift, Boros Charm, Deflecting Swat) — then Catch re-attaches Sunforger for free next turn instead of paying equip {3}.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "DEC-422 package analysis"
        }
      ]
    }
  ],
  "winConditions": [
    {
      "title": "21 commander damage",
      "kind": "combat",
      "cards": [
        "Excalibur, Sword of Eden",
        "Colossus Hammer",
        "Mjölnir, Hammer of Thor",
        "Sigarda's Aid",
        "Super-Soldier Serum"
      ],
      "description": "Free-attached kill pieces turn the 4/4 commander into a one- or two-hit clock: Colossus Hammer makes him 14/14, Excalibur 14/4 with vigilance, and Mjölnir doubles either into a single-connect kill. Super-Soldier Serum mass-attaches the whole armory when he attacks."
    },
    {
      "title": "Amplified Throw burn",
      "kind": "burst",
      "cards": [
        "Excalibur, Sword of Eden",
        "Mjölnir, Hammer of Thor",
        "Fiery Emancipation",
        "Chandra's Ignition"
      ],
      "description": "Throw converts gear into direct damage: Excalibur alone is 12 split three ways, 24 with Mjölnir attached, 72 with Fiery Emancipation — lethal at three faces. Chandra's Ignition off a suited-up Cap doubles as a board wipe that hits every opponent for his power."
    },
    {
      "title": "Infinite combats",
      "kind": "combo",
      "pieces": [
        "Sword of Feast and Famine",
        "Aggravated Assault"
      ],
      "cards": [
        "Sword of Feast and Famine",
        "Aggravated Assault"
      ],
      "description": "Sword of Feast and Famine untaps all lands on connect; Aggravated Assault converts {3}{R}{R} into an extra combat — every attack pays for the next. The deck's only infinite line, board-flagged per the DEC-422 combo watch."
    }
  ],
