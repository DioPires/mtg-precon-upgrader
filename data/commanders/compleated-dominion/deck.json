  "winConditions": [
    {
      "title": "Infinite Turns",
      "cards": [
        "Magistrate's Scepter",
        "Tekuthal, Inquiry Dominus",
        "Contagion Engine"
      ],
      "description": "Magistrate's Scepter takes an extra turn when you remove 3 charge counters. Contagion Engine proliferates twice per activation, doubled by Tekuthal to 4 proliferates. Each proliferate adds a charge counter to the Scepter. One Engine activation adds 4 counters, activate Scepter to take an extra turn. Repeat every turn for infinite turns, proliferating poison on each Atraxa end step until all opponents reach 10.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "Claude analysis",
          "detail": "Strategic win path identification"
        }
      ]
    },
    {
      "title": "Infinite Proliferate Loop",
      "cards": [
        "Shrieking Drake",
        "Crystalline Crawler",
        "Inexorable Tide"
      ],
      "description": "Crystalline Crawler enters with 4 +1/+1 counters in this 4-color deck. Remove counters for mana, cast Shrieking Drake for U bouncing itself. Inexorable Tide triggers proliferate, adding a counter back to Crawler. With Tekuthal, each cast adds 2 counters for net mana positive. Repeat infinitely: each loop proliferates all poison counters. All opponents die to poison after 10 loops.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "Claude analysis",
          "detail": "Strategic win path identification"
        }
      ]
    },
    {
      "title": "Blightsteel One-Shot",
      "cards": [
        "Blightsteel Colossus",
        "Rogue's Passage"
      ],
      "description": "Blightsteel Colossus is an 11/11 with infect and trample. A single unblocked hit delivers 11 poison counters, killing any player instantly. Rogue's Passage makes it unblockable for 4 mana. Even without evasion, trample means any blocker still lets through lethal infect damage against most boards.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "Claude analysis",
          "detail": "Strategic win path identification"
        }
      ]
    },
    {
      "title": "Vraska Poison Finish",
      "cards": [
        "Vraska, Betrayal's Sting",
        "Atraxa, Praetors' Voice",
        "Tekuthal, Inquiry Dominus"
      ],
      "description": "Vraska's ultimate gives target player 9 poison counters. With Atraxa proliferating loyalty each end step doubled by Tekuthal, Vraska reaches ultimate loyalty in 2 turns. Any opponent with 1+ existing poison counter dies immediately. Tutors (Demonic, Vampiric) reliably find Vraska when needed.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "Claude analysis",
          "detail": "Strategic win path identification"
        }
      ]
    },
    {
      "title": "Tutor into Combo",
      "cards": [
        "Demonic Tutor",
        "Vampiric Tutor",
        "Enlightened Tutor"
      ],
      "description": "Three efficient tutors find any combo piece on demand. Enlightened Tutor fetches Magistrate's Scepter or Contagion Engine at instant speed. Demonic and Vampiric find any card. Protected by free counterspells (Force of Will, Fierce Guardianship), the deck reliably assembles infinite turns or infinite proliferate within the first 5-6 turns.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "Claude analysis",
          "detail": "Strategic win path identification"
        }
      ]
    }
  ],
