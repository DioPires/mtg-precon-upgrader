          "Teferi's Ageless Insight",
          "Dirgur Focusmage // Braingeyser",
          "Mystical Tutor",
          "Solve the Equation",
          "Treason of Isengard"
        ]
      },
      {
        "name": "Interaction",
        "description": "Ten counterspells (seven with double blue pips — two tokens each) plus efficient bounce and polymorph removal. Interaction is token fuel here, never dead weight.",
        "cards": [
          "Arcane Denial",
          "An Offer You Can't Refuse",
          "Spell Pierce",
          "Stern Scolding",
          "Refute",
          "Saruman's Trickery",
