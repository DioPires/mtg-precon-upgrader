          "Mana Sculpt",
          "Brush Off",
          "Rapid Hybridization",
          "Reality Shift",
          "Resculpt",
          "Into the Flood Maw",
          "Press the Enemy",
          "Aether Gale",
          "Aetherize"
        ]
      },
      {
        "name": "Ramp & Cost Reduction",
        "description": "Rocks plus Sapphire Medallion and spell-cost reducers accelerate the commander and widen each turn's spell count.",
        "cards": [
          "Sapphire Medallion",
          "Arcane Signet",
          "Thought Vessel",
          "Mind Stone",
          "Worn Powerstone",
          "Basalt Monolith",
          "Solemn Simulacrum"
        ]
      },
      {
        "name": "Finishers",
        "description": "Burst payoffs that close: kicked Rite of Replication on a lord makes five anthems; Season of Weaving and Commander's Insight (triple pip — three tokens) restock while flooding the board.",
        "cards": [
          "Rite of Replication",
          "Season of Weaving",
          "Commander's Insight"
        ]
      }
    ]
