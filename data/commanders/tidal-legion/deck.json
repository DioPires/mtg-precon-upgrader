  "guideContent": {
    "strategyOverview": "Namor turns every blue pip in a noncreature spell into a 1/1 Merfolk — and his own power equals your Merfolk count, so the engine feeds the commander directly. The deck maximizes spell velocity: a dozen cantrips and draw spells backed by cheap tutors and graveyard rebuy keep the chain going, 10 counterspells (7 with double blue pips, each worth 2 tokens) protect the board while fueling it, and token payoffs like Curiosity Crafter and Bident of Thassa convert the swarm into cards. A light Merfolk lord package turns the 1/1s into a real clock and grows Namor into a commander-damage threat. Win by going wide with pumped tokens, or tall with Namor himself — he flies over stalled boards.",
    "deckCategories": [
      {
        "name": "Commander Engine",
        "description": "Namor converts blue pips on noncreature spells into 1/1 Merfolk tokens that raise his own power. Double-pip spells pay out double.",
        "cards": [
          "Namor the Sub-Mariner"
        ]
      },
      {
        "name": "Merfolk Lords & Typal",
        "description": "Anthems that turn the token swarm into a clock. Islandwalk from the classic lords makes the team unblockable against blue tables; Kopala and Svyelun protect the board.",
        "cards": [
          "Lord of Atlantis",
          "Master of the Pearl Trident",
          "Merrow Reejerey",
          "Vodalian Hexcatcher",
          "Merfolk Sovereign",
          "Svyelun of Sea and Sky",
          "Kopala, Warden of Waves",
          "Kiora, the Rising Tide",
          "Hydro-Channeler"
        ]
      },
      {
        "name": "Token & Spell Payoffs",
        "description": "Engines that convert spell velocity and token combat into cards and boards. Curiosity Crafter draws off every token hit; Shark Typhoon and Chrome Host Seedshark add flying bodies per spell; Faerie Mastermind taxes opponents' draws at flash speed.",
        "cards": [
          "Curiosity Crafter",
          "Bident of Thassa",
          "Archmage Emeritus",
          "Deekah, Fractal Theorist",
          "Chrome Host Seedshark",
          "Shark Typhoon",
          "Homunculus Horde",
          "Leitmotif Composer",
          "Deeproot Pilgrimage",
          "Master of Waves",
          "Faerie Mastermind"
        ]
      },
      {
        "name": "Spell Suite — Draw & Selection",
        "description": "Cantrip density keeps spell velocity high; every blue pip is a body. Mystical Tutor and Solve the Equation find the right spell, Treason of Isengard rebuys it, and Distant Melody refills naming Merfolk.",
        "cards": [
          "Brainstorm",
          "Ponder",
          "Preordain",
          "Opt",
          "Consult the Star Charts",
          "Quick Study",
          "Thirst for Knowledge",
          "Lórien Revealed",
