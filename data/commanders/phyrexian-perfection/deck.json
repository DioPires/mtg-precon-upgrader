  "synergies": [
    {
      "title": "Proliferate Engine",
      "cards": [
        "Atraxa, Praetors' Voice",
        "Tekuthal, Inquiry Dominus",
        "Inexorable Tide"
      ],
      "description": "Every spell you cast triggers Inexorable Tide for a proliferate. Tekuthal doubles each proliferate trigger. Atraxa adds another proliferate at end step. Net result: each spell cast = 2 proliferates, plus 2 more at end of turn. Poison counters escalate exponentially.",
      "sources": [
        {
          "type": "edhrec",
          "name": "EDHREC - Atraxa Proliferate",
          "url": "https://edhrec.com/commanders/atraxa-praetors-voice/proliferate"
        },
        {
          "type": "ai-inferred",
          "name": "Claude analysis",
          "detail": "Core engine identification"
        }
      ]
    },
    {
      "title": "Poison Spread",
      "cards": [
        "Ichor Rats",
        "Prologue to Phyresis"
      ],
      "description": "Both cards give all opponents poison counters simultaneously without combat. Ichor Rats on ETB gives each opponent 1 poison. Prologue to Phyresis gives each opponent 1 poison and proliferates. Ensures every opponent has counters for proliferate to amplify.",
      "sources": [
        {
          "type": "edhrec",
          "name": "EDHREC - Atraxa Infect",
          "url": "https://edhrec.com/commanders/atraxa-praetors-voice/infect"
        },
        {
          "type": "ai-inferred",
          "name": "Claude analysis"
        }
      ]
    },
    {
      "title": "Evasive Infect",
      "cards": [
        "Blighted Agent",
        "Grafted Exoskeleton"
      ],
      "description": "Blighted Agent is unblockable with infect. Grafted Exoskeleton adds +2/+2 and infect to any creature. On Blighted Agent: 3 unblockable infect damage per swing, needs only 4 hits with no proliferate to kill. With Atraxa proliferating each end step, 2-3 swings suffice.",
      "sources": [
        {
          "type": "edhrec",
          "name": "EDHREC - Atraxa Infect",
          "url": "https://edhrec.com/commanders/atraxa-praetors-voice/infect"
        },
        {
          "type": "ai-inferred",
          "name": "Claude analysis"
        }
      ]
    },
    {
      "title": "Vraska Finish",
      "cards": [
        "Vraska, Betrayal's Sting",
        "Atraxa, Praetors' Voice"
      ],
      "description": "Vraska's ultimate gives target player 9 poison counters. Starting loyalty 6, ultimate costs -9. With Atraxa proliferating loyalty each end step (doubled by Tekuthal), Vraska reaches ultimate in 2-3 turns instead of never. One-shot kill on any opponent.",
      "sources": [
        {
          "type": "edhrec",
          "name": "EDHREC - Atraxa Proliferate",
          "url": "https://edhrec.com/commanders/atraxa-praetors-voice/proliferate"
        },
        {
          "type": "ai-inferred",
          "name": "Claude analysis"
        }
      ]
    },
    {
      "title": "Landfall Proliferate",
      "cards": [
        "Evolution Sage",
        "Farseek"
      ],
      "description": "Evolution Sage proliferates on every landfall. Farseek, Nature's Lore, and Three Visits fetch dual lands (shock lands), triggering landfall. Each ramp spell = mana fixing + proliferate trigger. Chains with other land-based ramp for multiple proliferates per turn.",
      "sources": [
        {
          "type": "edhrec",
          "name": "EDHREC - Atraxa Proliferate",
          "url": "https://edhrec.com/commanders/atraxa-praetors-voice/proliferate"
        },
        {
          "type": "ai-inferred",
          "name": "Claude analysis"
        }
      ]
    }
