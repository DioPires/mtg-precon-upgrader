      },
      {
        "name": "Overrun & Combo Finishes",
        "description": "Close the game: two one-shot overrun lords (trample and flying) and an infinite-token combo (Scurry Oak + Rosie Cotton) that turns lethal with any ETB pinger.",
        "cards": [
