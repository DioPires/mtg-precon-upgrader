    {
      "type": "ai-inferred",
      "name": "DEC-347 — board-approved Naya tokens build (6 review rounds + owned-swap pass)"
    }
  ],
  "guideContent": {
    "strategyOverview": "Baylen, the Haymaker is a Naya (RGW) go-wide tokens deck. Baylen doesn't make tokens himself — he consumes a wide board, tapping untapped tokens to ramp into any color, draw cards, and grow with trample. The 99 flood the board with unconditional and instant-speed token makers, multiply them with doublers, and convert the swarm into damage through ETB pingers, anthems, and overrun. Two compact combos (Scurry Oak + Rosie Cotton, Kiki-Jiki + Zealous Conscripts) provide infinite-token inevitability that turns lethal alongside Impact Tremors or Purphoros.",
    "deckCategories": [
      {
        "name": "Token Producers",
        "description": "Unconditional and instant-speed makers that flood the board from an empty start — several can fire on opponents' turns.",
        "cards": [
          "Dragon Fodder",
          "Hordeling Outburst",
          "Raise the Alarm",
          "Secure the Wastes",
          "Grand Crescendo",
          "March of the Multitudes",
          "Prosperous Partnership",
          "Springheart Nantuko",
          "Felidar Retreat",
          "Halo Fountain",
          "Adeline, Resplendent Cathar",
          "Anim Pakal, Thousandth Moon",
          "Scute Swarm",
          "Pest Infestation"
        ]
      },
      {
        "name": "Token Multipliers",
        "description": "Doublers and a tripler that turn every maker into an exponential flood.",
        "cards": [
          "Anointed Procession",
          "Parallel Lives",
          "Mondrak, Glory Dominus",
          "Ojer Taq, Deepest Foundation // Temple of Civilization",
          "Elspeth, Storm Slayer",
          "Exalted Sunborn",
          "Second Harvest"
        ]
      },
      {
        "name": "Token Payoffs & Anthems",
        "description": "Convert width into damage — ETB pingers fire per token, anthems push the swarm through.",
        "cards": [
          "Impact Tremors",
          "Purphoros, God of the Forge",
          "Rosie Cotton of South Lane",
          "Warleader's Call",
          "Wedding Announcement // Wedding Festivity",
          "Dictate of Heliod"
        ]
      },
      {
        "name": "Baylen's Engine",
        "description": "Card advantage and untap effects that refuel the swarm and let Baylen tap the board for mana, cards, and pressure — every turn.",
        "cards": [
          "Baylen, the Haymaker",
          "Seedborn Muse",
          "Skullclamp",
          "Tocasia's Welcome",
          "Staff of the Storyteller",
          "Mentor of the Meek",
          "Bennie Bracks, Zoologist",
          "The Great Henge",
          "Caretaker's Talent"
        ]
      },
      {
        "name": "Overrun & Combo Finishes",
        "description": "Close the game: a static double-strike anthem, a one-shot trample lord, and two infinite-token combos that turn lethal with any ETB pinger.",
        "cards": [
          "Jetmir, Nexus of Revels",
          "Craterhoof Behemoth",
          "Scurry Oak",
          "Rosie Cotton of South Lane",
          "Kiki-Jiki, Mirror Breaker",
          "Zealous Conscripts",
          "Natural Order"
        ]
      },
      {
        "name": "Interaction",
        "description": "Clean spot removal, two asymmetric wipes that spare our tokens, and board protection.",
        "cards": [
          "Swords to Plowshares",
          "Path to Exile",
          "Winds of Abandon",
          "Artifact Mutation",
          "Aura Shards",
          "Hour of Reckoning",
          "The Battle of Bywater",
          "Clever Concealment",
          "Voice of Victory",
          "Flawless Maneuver",
          "Mother of Runes"
        ]
      }
    ]
  },
  "winConditions": [
    {
      "name": "Go-wide overrun",
      "cards": [
        "Jetmir, Nexus of Revels",
        "Craterhoof Behemoth",
        "Warleader's Call"
      ],
      "description": "A wide token board plus a static double-strike anthem (Jetmir) or a one-shot trample pump (Craterhoof) swings for lethal in a single attack."
    },
    {
      "name": "Infinite tokens — Scurry Oak line",
      "cards": [
        "Scurry Oak",
        "Rosie Cotton of South Lane",
        "Impact Tremors",
        "Purphoros, God of the Forge"
      ],
      "description": "Whenever you create a token, Rosie Cotton puts a +1/+1 counter on Scurry Oak, which makes a 1/1 green Squirrel — itself a token — looping infinitely. With Impact Tremors or Purphoros on board, each token deals damage: infinite damage."
    },
    {
      "name": "Infinite tokens — Kiki line",
      "cards": [
        "Kiki-Jiki, Mirror Breaker",
        "Zealous Conscripts",
        "Impact Tremors",
        "Purphoros, God of the Forge"
      ],
      "description": "Kiki-Jiki copies Zealous Conscripts; the copy's ETB untaps Kiki to repeat — infinite hasty tokens and ETBs, lethal with any ETB pinger or a swing."
    },
    {
      "name": "Halo Fountain alternate win",
      "cards": [
        "Halo Fountain",
        "Seedborn Muse"
      ],
      "description": "On a wide, vigilant board, untap fifteen creatures to Halo Fountain's third ability and win the game outright — trivial with Seedborn Muse untapping each turn."
    }
  ],
  "synergies": [
    {
      "title": "Baylen converts a wide board into mana, cards, and reach",
      "cards": [
        "Baylen, the Haymaker",
        "Anointed Procession",
        "Mondrak, Glory Dominus"
      ],
      "description": "Every extra token is more fuel for Baylen's tap abilities (2 tokens = any-color mana, 3 = draw, 4 = +3/+3 trample). Doublers multiply both the swarm and Baylen's activations.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "Commander synergy analysis"
        }
      ]
    },
    {
      "title": "Scurry Oak + Rosie Cotton = infinite tokens",
      "cards": [
        "Scurry Oak",
        "Rosie Cotton of South Lane"
      ],
      "description": "Each Squirrel Scurry Oak makes is a token, so Rosie Cotton puts a +1/+1 counter on Scurry Oak, which makes another Squirrel — a mana-free infinite loop.",
      "sources": [
        {
          "type": "commanderspellbook",
          "name": "Commander Spellbook combo"
        }
      ]
    },
    {
      "title": "Kiki-Jiki + Zealous Conscripts = infinite tokens",
      "cards": [
        "Kiki-Jiki, Mirror Breaker",
        "Zealous Conscripts"
      ],
      "description": "Kiki copies Conscripts; the token's ETB untaps Kiki to copy again — infinite hasty tokens and ETB triggers.",
      "sources": [
        {
          "type": "commanderspellbook",
          "name": "Commander Spellbook combo"
        }
      ]
    },
    {
      "title": "ETB pingers scale with token doublers",
      "cards": [
        "Impact Tremors",
        "Purphoros, God of the Forge",
        "Anointed Procession"
      ],
      "description": "Impact Tremors and Purphoros fire for every creature that enters; doublers multiply each token wave, multiplying the damage independent of creature power.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "Token payoff analysis"
        }
      ]
    },
    {
      "title": "Seedborn Muse lets Baylen and instant-makers work every turn",
      "cards": [
        "Seedborn Muse",
        "Baylen, the Haymaker",
        "Secure the Wastes"
      ],
      "description": "Untapping all permanents on each opponent's turn means Baylen taps the board around the table and instant-speed makers (Secure the Wastes, Grand Crescendo) flash in blockers and fuel.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "Engine analysis"
        }
      ]
    },
    {
      "title": "Skullclamp turns 1/1 tokens into card advantage",
      "cards": [
        "Skullclamp",
        "Dragon Fodder",
        "Hordeling Outburst"
      ],
      "description": "Equipping Skullclamp to a 1/1 token kills it and draws two — a relentless draw engine fed by every cheap token maker.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "Card advantage analysis"
        }
      ]
    }
  ],
