  "winConditions": [
    {
      "name": "Go-wide overrun",
      "kind": "combat",
      "cards": [
        "Craterhoof Behemoth",
        "Moonshaker Cavalry",
        "Warleader's Call"
      ],
      "description": "A wide token board plus a one-shot pump from Craterhoof Behemoth (trample) or Moonshaker Cavalry (flying) swings for lethal in a single attack; Worldly Tutor fetches either, Natural Order fetches Craterhoof; Warleader's Call adds reach."
    },
    {
      "name": "Infinite tokens — Scurry Oak line",
      "kind": "combo",
      "pieces": [
        "Scurry Oak",
        "Rosie Cotton of South Lane"
      ],
      "cards": [
        "Scurry Oak",
        "Rosie Cotton of South Lane",
        "Impact Tremors",
        "Purphoros, God of the Forge"
      ],
      "description": "Whenever you create a token, Rosie Cotton puts a +1/+1 counter on Scurry Oak, which makes a 1/1 green Squirrel — itself a token — looping infinitely. With Impact Tremors or Purphoros on board, each token deals damage: infinite damage."
    },
    {
      "name": "Halo Fountain alternate win",
      "kind": "alt-win",
      "cards": [
        "Halo Fountain",
        "Seedborn Muse"
      ],
      "description": "On a wide, vigilant board, untap fifteen creatures to Halo Fountain's third ability and win the game outright — trivial with Seedborn Muse untapping each turn."
    }
  ],
  "synergies": [
    {
      "title": "Baylen converts a wide board into mana, cards, and reach",
      "cards": [
        "Baylen, the Haymaker",
        "Anointed Procession",
        "Mondrak, Glory Dominus"
      ],
      "description": "Every extra token is more fuel for Baylen's tap abilities (2 tokens = any-color mana, 3 = draw, 4 = +3/+3 trample). Doublers multiply both the swarm and Baylen's activations.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "Commander synergy analysis"
        }
      ]
    },
    {
      "title": "Scurry Oak + Rosie Cotton = infinite tokens",
      "cards": [
        "Scurry Oak",
        "Rosie Cotton of South Lane"
      ],
      "description": "Each Squirrel Scurry Oak makes is a token, so Rosie Cotton puts a +1/+1 counter on Scurry Oak, which makes another Squirrel — a mana-free infinite loop.",
      "sources": [
        {
          "type": "commanderspellbook",
          "name": "Commander Spellbook combo"
        }
      ]
    },
    {
      "title": "Flurry Monks feed the ETB-pinger + doubler engine",
      "cards": [
        "Cori-Steel Cutter",
        "Aligned Heart",
        "Impact Tremors"
      ],
      "description": "Each Flurry trigger makes a 1/1 Monk; every Monk is a token (multiplied by Anointed Procession/Mondrak) and a creature ETB that pings with Impact Tremors/Purphoros and grows Scurry Oak via Rosie Cotton. Cori-Steel Cutter's equip hands a single Monk haste + trample to push damage through.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "DEC-358 — board-approved token-engine swap"
        }
      ]
    },
    {
      "title": "ETB pingers scale with token doublers",
      "cards": [
        "Impact Tremors",
        "Purphoros, God of the Forge",
        "Anointed Procession"
      ],
      "description": "Impact Tremors and Purphoros fire for every creature that enters; doublers multiply each token wave, multiplying the damage independent of creature power.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "Token payoff analysis"
        }
      ]
    },
    {
      "title": "Seedborn Muse lets Baylen and instant-makers work every turn",
      "cards": [
        "Seedborn Muse",
        "Drumbellower",
        "Baylen, the Haymaker",
        "Secure the Wastes"
      ],
      "description": "Untapping all permanents on each opponent's turn means Baylen taps the board around the table and instant-speed makers (Secure the Wastes, Grand Crescendo) flash in blockers and fuel. Drumbellower is the redundant copy of the effect for creatures — it untaps all your creatures during each other player's untap step, so token fuel comes back for Baylen three extra times per turn cycle even when Seedborn Muse is answered.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "Engine analysis"
        }
      ]
    },
    {
      "title": "Skullclamp turns 1/1 tokens into card advantage",
      "cards": [
        "Skullclamp",
        "The Queen of Dale"
      ],
      "description": "Equipping Skullclamp to a 1/1 token kills it and draws two — a relentless draw engine. The Queen of Dale restocks the fodder: her recruit trigger on each opponent's first noncreature spell makes a 1/1 Soldier whenever the discard is a nonland card.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "Card advantage analysis"
        }
      ]
    },
    {
      "title": "Token creation feeds board-independent draw",
      "cards": [
        "Bennie Bracks, Zoologist",
        "Idol of Oblivion",
        "Baylen, the Haymaker",
        "Smothering Tithe"
      ],
      "description": "Bennie Bracks (each end step) and Idol of Oblivion (tap) draw off the near-automatic token-per-turn stream without spending the board, while their casts and Clues/Food still count as Baylen fuel — draw that survives losing the commander. Smothering Tithe widens the stream to opponents' turns: each opponent draw makes a Treasure unless they pay {2}, so Bennie can draw at every end step, not only ours.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "DEC-378 draw-engine analysis"
        },
