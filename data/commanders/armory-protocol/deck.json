  "guideContent": {
    "strategyOverview": "Tony Stark's front face is a one-mana-per-activation periscope that digs four deep for the deck's 40 artifacts, assembling the armory while the mana base develops. At six mana (four with Training Grounds) he transforms into a 5/5 flying haste threat that deploys one artifact from hand per combat entirely free — Equipment attach directly to him, bypassing both cast and equip costs. The primary kill is 21 commander damage through free-attached blades: Excalibur, Sword of Eden keeps him airborne at 15 power, and adding Fireshrieker makes it a single-combat 30. The same deploy trigger doubles as a mana cheat for haymaker artifacts (Phyrexian Triniform, Ancient Stone Idol), so removal-heavy tables still face a stream of oversized threats. Blue backup counterspells protect the suit; if the commander plan stalls, Kappa Cannoneer, Cyberdrive Awakener, and Hellkite Tyrant win off raw artifact density.",
    "deckCategories": [
      {
        "name": "The Armory",
        "description": "Kill-piece Equipment the back face attaches for free at each combat. Excalibur (+10/+0) keeps flying for a two-hit clock; Fireshrieker converts it into a one-combat 30. Colossus Hammer is +10/+10 but strips flying — it is deployed alongside Whispersilk Cloak or Trailblazer's Boots, never as the lone plan.",
        "cards": [
          "Excalibur, Sword of Eden",
          "Aettir and Priwen",
          "Kaldra Compleat",
          "Colossus Hammer",
          "Embercleave",
          "Fireshrieker",
          "The Reaver Cleaver",
          "Iron Man Armor"
        ]
      },
      {
        "name": "Flight Systems",
        "description": "Evasion and protection for the suit: unblockable via Whispersilk Cloak (its shroud does not stop the back face's attach — the trigger doesn't target), nonbasic landwalk, boots haste-shielding, and indestructibility on demand.",
        "cards": [
          "Whispersilk Cloak",
          "Trailblazer's Boots",
          "Lightning Greaves",
          "Mithril Coat",
          "Padeem, Consul of Innovation"
        ]
      },
      {
        "name": "Heavy Ordnance",
        "description": "Alternate free-deploy targets when the table answers the Voltron line. Each combat the back face can put one of these into play at zero mana; Nexus of Becoming adds a second deploy stream.",
        "cards": [
          "Kappa Cannoneer",
          "Phyrexian Triniform",
          "Ancient Stone Idol",
          "Steel Hellkite",
          "Cyberdrive Awakener",
          "Hellkite Tyrant",
          "Nexus of Becoming",
          "Iron Man, Bleeding Edge"
        ]
      },
      {
        "name": "Attach Redundancy",
        "description": "Backup equip-cost cheats so removal on the commander doesn't strand a hand of swords.",
        "cards": [
          "Armory Automaton",
          "Kazuul's Toll Collector",
          "Shuri, Wakandan Inventor"
        ]
      },
      {
        "name": "R&D",
        "description": "Card flow and toolbox access. Tribute Mage fetches two-mana artifacts (Trailblazer's Boots), Trophy Mage the three-slot (Whispersilk Cloak, Fireshrieker, Mithril Coat), and Fabricate or Whir of Invention find anything.",
        "cards": [
          "Emry, Lurker of the Loch",
          "Thirst for Knowledge",
          "Mask of Memory",
          "Thought Monitor",
          "Combustible Gearhulk",
          "Iron Man, Master of Machines",
          "Windfall",
          "Big Score",
          "Fabricate",
          "Whir of Invention",
          "Tribute Mage",
          "Trophy Mage"
        ]
      },
      {
        "name": "Defense Grid",
        "description": "Counterspells to protect the transform and the suit, flexible removal, and two red sweepers that reset go-wide boards — the commander rebuilds from the command zone faster than anyone. Stubborn Denial is a hard counter once the 5/5 is online.",
        "cards": [
          "Counterspell",
          "Negate",
          "Stubborn Denial",
          "Arcane Denial",
          "Chaos Warp",
          "Abrade",
          "Prismari Command",
          "Rapid Hybridization",
          "Blasphemous Act",
          "Chain Reaction",
          "Resculpt",
          "Reality Shift"
        ]
      },
      {
        "name": "Power Systems",
        "description": "Rocks and cost reducers that double as artifact-count fuel for Kappa Cannoneer, improvise, and Hellkite Tyrant's twenty-artifact clause. Training Grounds cuts the transform to {2}{U}{R} (the dig stays {1} — the effect can't reduce below one mana).",
        "cards": [
          "Sol Ring",
          "Arcane Signet",
          "Izzet Signet",
          "Talisman of Creativity",
          "Mind Stone",
          "Thought Vessel",
          "Fellwar Stone",
          "Worn Powerstone",
          "Everflowing Chalice",
          "Arc Reactor",
          "Sword of the Animist",
          "Foundry Inspector",
          "Etherium Sculptor",
          "Enthusiastic Mechanaut",
          "Training Grounds"
        ]
      }
    ]
  },
