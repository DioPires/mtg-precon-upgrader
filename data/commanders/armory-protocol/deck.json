  "synergies": [
    {
      "title": "One-combat commander kill",
      "cards": [
        "Excalibur, Sword of Eden",
        "Fireshrieker"
      ],
      "description": "The back face attaches Excalibur free (+10/+0, flying retained → 15/5), and a prior-turn Fireshrieker makes it double strike: 30 commander damage in a single combat.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "DEC-402 kill-line analysis"
        }
      ]
    },
    {
      "title": "Hammer needs a cloak",
      "cards": [
        "Colossus Hammer",
        "Whispersilk Cloak"
      ],
      "description": "Colossus Hammer is +10/+10 but the equipped creature loses flying. Whispersilk Cloak makes the 15/15 unblockable, and its shroud doesn't block the attach — the back face's trigger doesn't target the creature.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "DEC-402 kill-line analysis (board-corrected)"
        }
      ]
    },
    {
      "title": "Cheap suit-up",
      "cards": [
        "Training Grounds"
      ],
      "description": "Transform drops from {4}{U}{R} to {2}{U}{R}; the {1} dig activation is unaffected (Training Grounds can't reduce an ability below one mana).",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "DEC-402 oracle verification"
        }
      ]
    },
    {
      "title": "Twin deploy streams",
      "cards": [
        "Nexus of Becoming",
        "Phyrexian Triniform",
        "Ancient Stone Idol"
      ],
      "description": "Nexus and the transformed commander each cheat an artifact into play at the start of combat — two free haymakers per turn without spending mana.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "DEC-402 build analysis"
        }
      ]
    },
    {
      "title": "Armory recycling",
      "cards": [
        "Emry, Lurker of the Loch",
        "Academy Ruins"
      ],
      "description": "Destroyed Equipment comes back: Emry recasts artifacts from the graveyard (cost cut by the deck's reducers), Academy Ruins tops the library with anything she can't reach.",
      "sources": [
        {
          "type": "edhrec",
          "name": "EDHREC — Tony Stark",
          "url": "https://edhrec.com/commanders/tony-stark"
        }
      ]
    },
    {
      "title": "Density payoffs",
      "cards": [
        "Kappa Cannoneer",
        "Hellkite Tyrant",
        "Cyberdrive Awakener"
      ],
      "description": "Forty artifacts turn on the deck's B-plan: Kappa grows unblockable with ward 4, Cyberdrive animates the rock suite for an alpha strike, and Hellkite Tyrant threatens the twenty-artifact win with Treasure support.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "DEC-402 build analysis"
        }
      ]
    },
    {
      "title": "Backup attachers",
      "cards": [
        "Armory Automaton",
        "Kazuul's Toll Collector",
        "Colossus Hammer"
      ],
      "description": "Both cheat equip costs if the commander is answered — Armory Automaton grabs every Equipment on entry or attack, Kazuul's Toll Collector re-suits for free each turn.",
      "sources": [
        {
          "type": "edhrec",
          "name": "EDHREC — Tony Stark",
          "url": "https://edhrec.com/commanders/tony-stark"
        }
      ]
    }
  ],
  "winConditions": [
