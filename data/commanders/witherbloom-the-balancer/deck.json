  "winConditions": [
    {
      "title": "X-Drain Finishers (Exsanguinate / Torment of Hailfire)",
      "cards": [
        "Exsanguinate",
        "Torment of Hailfire",
        "Stensian Sanguinist // Exsanguinate"
      ],
      "description": "Primary win condition. Build a wide creature board (typically 8-12 by turn 6-7 via Bitterblossom, Ophiomancer, Awakening Zone, Pawn of Ulamog, Mycoloth, etc.). Affinity drops Exsanguinate's `{X}{B}{B}` and Torment of Hailfire's `{X}{B}{B}{B}` by the creature count. With 8 creatures and 10 mana available, you can cast a 10-Exsanguinate for just `{B}{B}` (affinity discount removes 8 generic; 10 mana left as X). Stensian Sanguinist's prepared trigger generates free Exsanguinate copies after combat damage.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "DEC-226 analysis",
          "detail": "Primary closer; scales with board"
        }
      ]
    },
    {
      "title": "Commander Damage (Witherbloom)",
      "cards": [
        "Witherbloom, the Balancer",
        "Swiftfoot Boots"
      ],
      "description": "Backup wincon. Commander is a 5/5 flying/deathtouch — only 3 hits to lethal commander damage. With Swiftfoot Boots (hexproof + haste) and affinity making recasts cheap (free with 8 creatures), Witherbloom is hard to remove permanently. 4 attacks via 2 castings + commander tax handling closes a player.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "DEC-226 analysis",
          "detail": "Secondary wincon"
        }
      ]
    }
  ],
