    {
      "title": "Sprout Swarm Buyback Engine",
      "cards": [
        "Sprout Swarm",
        "Witherbloom, the Balancer"
      ],
      "description": "Sprout Swarm is `{1}{G}` instant with buyback `{3}` that creates a 1/1 saproling. Witherbloom's affinity grant applies to both the base cast and the buyback. With 5+ creatures, the buyback cost drops to {G} — cast at the end of every opponent's turn, the saproling joins our board, the card returns to hand, and next turn the buyback is even cheaper. Single best self-feeding card in this archetype.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "DEC-226 analysis"
        }
      ]
    },
    {
      "title": "Aristocrats + Death Triggers",
      "cards": [
        "Blood Artist",
        "Zulaport Cutthroat",
        "Witherbloom Apprentice",
        "Pawn of Ulamog",
        "Pitiless Plunderer",
        "Grave Pact",
        "Carrion Feeder",
        "Viscera Seer"
      ],
      "description": "Every creature death triggers Blood Artist + Zulaport (drain 2 in 4-player), Pawn of Ulamog (new token), Pitiless Plunderer (treasure ramp), and Grave Pact (forces opponent sacs). Sac outlets (Viscera Seer scry, Carrion Feeder pumping) convert tokens into value. Witherbloom Apprentice adds 3 more life-swing per I/S cast.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "DEC-226 analysis"
        }
      ]
    },
    {
      "title": "Prepared Engine — Recurring Free Sorceries",
      "cards": [
        "Stensian Sanguinist // Exsanguinate",
        "Emeritus of Woe // Demonic Tutor",
        "Grave Researcher // Reanimate",
        "Leech Collector // Bloodletting"
      ],
      "description": "Four Prepared creatures each generate a copy of their attached sorcery on a recurring trigger. Sanguinist: Exsanguinate copies on combat damage. Emeritus: Demonic Tutor copies whenever 2+ creatures died this turn (aristocrats territory). Grave Researcher: Reanimate copies as long as 3+ creature cards are in GY. Leech Collector: Bloodletting (2-life drain) on first lifegain each turn. All copies are sorceries we cast — affinity applies to each.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "DEC-226 analysis"
        }
      ]
    },
    {
