  "synergies": [
    {
      "title": "Zimone + X-Hydras: discounted, snowballing threats",
      "cards": [
        "Zimone, Infinite Analyst",
        "Unbound Flourishing",
        "Primordial Hydra",
        "Hydroid Krasis"
      ],
      "description": "Each turn's first X-spell puts two +1/+1 counters on Zimone and is discounted by {1} per counter on her, so every Hydra you cast makes the next one cheaper. Unbound Flourishing doubles X on those Hydra (permanent) casts, so a Primordial Hydra or Hydroid Krasis enters twice as large.",
      "sources": [
        {
          "type": "scryfall",
          "name": "Card text verification"
        },
        {
          "type": "ai-inferred",
          "name": "Engine analysis (DEC-351)"
        }
      ]
    },
    {
      "title": "Doubling Season + Kalonian Hydra: counters spiral",
      "cards": [
        "Doubling Season",
        "Kalonian Hydra",
        "Primordial Hydra"
      ],
      "description": "Doubling Season doubles every counter that enters (Hydras come in twice as big). Kalonian Hydra then doubles all +1/+1 counters on each creature you control whenever it attacks — one combat step can quadruple your board.",
      "sources": [
        {
          "type": "scryfall",
          "name": "Card text verification"
        },
        {
          "type": "ai-inferred",
          "name": "Synergy analysis (DEC-351)"
        }
      ]
    },
    {
      "title": "Warden of the Grove + creature ETBs (doubled)",
      "cards": [
        "Warden of the Grove",
        "Doubling Season",
        "Master Biomancer"
      ],
      "description": "Warden of the Grove makes every other nontoken creature that enters endure X (X = counters on Warden) — dumping counters onto each new Hydra or spawning Spirit tokens. Doubling Season doubles the endure counters, and Master Biomancer stacks even more on each ETB.",
      "sources": [
        {
          "type": "scryfall",
          "name": "Card text verification"
        },
        {
          "type": "ai-inferred",
          "name": "Synergy analysis (DEC-351)"
        }
      ]
    },
    {
      "title": "Unblockable / overrun finish",
      "cards": [
        "Herald of Secret Streams",
        "Pathbreaker Ibex",
        "Zegana, Utopian Speaker"
      ],
      "description": "Herald of Secret Streams makes every creature with a +1/+1 counter unblockable; Zegana grants them all trample; Pathbreaker Ibex pumps the team by your biggest creature's power on attack. Any of these turns a tall counter board into a lethal swing.",
      "sources": [
        {
          "type": "ai-inferred",
          "name": "Wincon analysis (DEC-351)"
        }
      ]
    },
    {
      "title": "Terrasymbiosis: bulk counters into cards",
      "cards": [
        "Terrasymbiosis",
        "Doubling Season",
        "Primordial Hydra",
        "Forgotten Ancient"
      ],
      "description": "Terrasymbiosis draws cards equal to the +1/+1 counters placed in a single event (once per turn). A Hydra entering with X counters — doubled by Doubling Season/Branching Evolution — or a Forgotten Ancient counter dump turns one trigger into a 5-15 card refill. As an enchantment it survives board wipes, refueling the engine when the creatures don't.",
      "sources": [
        {
          "type": "scryfall",
          "name": "Card text verification"
        },
        {
          "type": "ai-inferred",
          "name": "Card assessment (DEC-356)"
        }
      ]
    },
    {
      "title": "Simic Ascendancy alternate win",
      "cards": [
        "Simic Ascendancy",
        "Doubling Season",
        "Hardened Scales"
      ],
      "description": "Every +1/+1 counter you place adds a growth counter to Simic Ascendancy; at 20 you win at upkeep. With doublers placing counters in bulk, this can close even through a stalled board.",
      "sources": [
        {
          "type": "scryfall",
          "name": "Card text verification"
        },
        {
          "type": "ai-inferred",
          "name": "Wincon analysis (DEC-351)"
        }
      ]
    }
