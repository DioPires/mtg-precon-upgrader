       fireEvent.click(screen.getByRole('button', { name: /Select all/i }));
       expect(within(ownHead()).getByText('· 1 unique · 2 cards')).toBeInTheDocument();
     });
+
+    // The user owns Solo A Commander alone. With both decks selected, Need to buy holds
+    // Solo B Commander and two Sol Rings (2 unique, 3 cards) and Already own holds one
+    // card, so each header must read the counts of its own section.
+    it('reads `2 unique · 3 cards` to buy and `1 unique · 1 card` owned when the sections hold different counts', () => {
+      localStorage.setItem(STORAGE_KEY, JSON.stringify([['Solo A Commander', 1]]));
+      renderShopping([SOLO_A, SOLO_B]);
+      fireEvent.click(screen.getByRole('button', { name: /Select all/i }));
+      expect(within(buyHead()).getByText('· 2 unique · 3 cards')).toBeInTheDocument();
+      expect(within(ownHead()).getByText('· 1 unique · 1 card')).toBeInTheDocument();
+    });
   });
 });
 
diff --git a/web/src/__tests__/lib/cardNoun.test.ts b/web/src/__tests__/lib/cardNoun.test.ts
index 8c53c23..1ad7b50 100644
--- a/web/src/__tests__/lib/cardNoun.test.ts
+++ b/web/src/__tests__/lib/cardNoun.test.ts
@@ -10,8 +10,9 @@ describe('cardNoun', () => {
 
   // Each count holds the helper to its declared type (`count: number`): 0 and 0.5
   // fail `count <= 1` and `count < 2`, 2 fails `count > 1 ? 'cards' : 'card'`, and
-  // -1 fails `Math.abs(count) === 1`.
-  it.each([0, 2, -1, 0.5, NaN])('gives `cards` for a count of %s', (count) => {
+  // -1 fails `Math.abs(count) === 1`. 0.5 fails `Math.round` and `Math.ceil`, and
+  // 1.5 fails `Math.floor` and `Math.trunc`.
+  it.each([0, 2, -1, 0.5, 1.5, NaN])('gives `cards` for a count of %s', (count) => {
     expect(cardNoun(count)).toBe('cards');
   });
 });
