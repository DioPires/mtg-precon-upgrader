 "winConditions": [
  {
   "title": "Nest Cascade",
   "kind": "combo",
   "pieces": [
    "Mirror Entity"
   ],
   "cards": [
    "Mirror Entity",
    "Worldspine Wurm",
    "Vigor"
   ],
   "description": "With Atla out, activate Mirror Entity for X=0: every creature you control becomes a 0/0 Egg and dies. Atla hatches a nonegg creature from the library for each death, flooding the board with bombs. Worldspine Wurm and Vigor shuffle back from the graveyard, so repeat activations keep finding fuel."
  },
  {
   "title": "Thornbite Hatch Engine",
   "kind": "combo",
   "pieces": [
    "Thornbite Staff",
    "Ashnod's Altar"
   ],
   "cards": [
    "Thornbite Staff",
    "Ashnod's Altar",
    "Phyrexian Altar",
    "Goblin Bombardment"
   ],
   "description": "Equip Thornbite Staff to Atla. Pay {2},{T} for an Egg, sacrifice it to Ashnod's Altar for {C}{C}, and the death untaps Atla via the Staff. Each mana-neutral loop hatches a creature off the top of the library."
  },
  {
   "title": "Hatch-and-Burn",
   "kind": "drain",
   "cards": [
    "Purphoros, God of the Forge",
    "Impact Tremors",
    "Terror of the Peaks",
    "Warleader's Call"
   ],
   "description": "Mass hatches convert directly to noncombat damage: each hatched bomb triggers every ETB-damage payoff, so a Mirror Entity cascade kills the table without attacking."
  },
  {
   "title": "Titan Combat",
   "kind": "combat",
   "cards": [
    "Craterhoof Behemoth",
    "Blightsteel Colossus",
    "Etali, Primal Conqueror // Etali, Primal Sickness",
    "Zacama, Primal Calamity"
   ],
   "description": "The fair plan: cheat 8-plus-mana bodies into play early through egg deaths and swing."
  }
 ],
